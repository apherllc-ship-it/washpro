# Copy to server/.env for local development (Prisma and the server both read it). Never commit real values.

# --- Core ---
NODE_ENV=development
PORT=4000
# Public URL of the app (used in emails and Stripe redirects). Locally the Vite dev server runs on 5173.
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/washpro?schema=public
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- First admin account (created by the seed if it doesn't exist) ---
ADMIN_EMAIL=admin@washpro.test
ADMIN_PASSWORD=Admin12345
# Set to true to also create demo pro/customer accounts (password: Password123)
SEED_DEMO=false

# --- Initial business details (seed only; edit later in Admin > Settings) ---
BUSINESS_NAME=WashPro Exterior Cleaning
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_LAT=
BUSINESS_LNG=

# --- Google Maps Platform ---
# Browser key: Maps JavaScript API + Places API (New). Restrict by HTTP referrer to your domain.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID (Cloud styling)
GOOGLE_MAPS_MAP_ID=
# Server key: Geocoding API, Routes API, Solar API. Restrict by API (and IP if possible).
GOOGLE_MAPS_SERVER_KEY=

# --- Email (any SMTP provider: SendGrid, Postmark, Mailgun, Gmail SMTP...) ---
# Leave SMTP_HOST empty to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WashPro <no-reply@yourdomain.com>

# --- SMS (optional, Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Deposits (optional, Stripe Checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
